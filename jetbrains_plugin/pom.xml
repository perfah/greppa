<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.perfah</groupId>
    <artifactId>greppa</artifactId>
    <version>1.0.6</version>
    <packaging>jar</packaging>

    <name>Greppa</name>
    <description>JetBrains plugin providing AI-based auto-completion via an external Rust LSP server.</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Path to a classpath jar produced by the build script that
             references all IDE jars. It MUST be generated from the same
             IDE installation the plugin runs in (see discover-jars.ps1
             and its -IdeaHome parameter): these jars are the only
             IntelliJ Platform on the compile classpath, and the JVM links
             platform classes by name at runtime, so compiling against one
             IDE version and running the plugin in another surfaces as
             NoSuchFieldError / NoSuchMethodError / NoClassDefFoundError
             when the plugin loads. -->
        <idea.classpath.jar></idea.classpath.jar>
        <!-- Lsp4j version to compile and bundle against. Verify it matches
             the lsp4j-<version>.jar actually present in the IDE's lib
             directory and update if it differs. -->
        <lsp4j.version>0.21.0</lsp4j.version>
    </properties>

    <dependencies>
        <!-- Gson is bundled with JetBrains IDEs. -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>24.0.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- The IDE does not export its bundled lsp4j to third-party plugin
             classloaders, so the classes are missing at runtime unless the
             plugin bundles them itself. Declared before ide-classpath so
             javac resolves this version first; org.eclipse.lsp4j.jsonrpc
             comes in transitively. -->
        <dependency>
            <groupId>org.eclipse.lsp4j</groupId>
            <artifactId>org.eclipse.lsp4j</artifactId>
            <version>${lsp4j.version}</version>
            <scope>compile</scope>
        </dependency>
        <!-- Classpath jar that references every IntelliJ Platform jar. -->
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>ide-classpath</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${idea.classpath.jar}</systemPath>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <fork>true</fork>
                    <!-- The .exe extension matters: the forked compiler is
                         launched as a Windows process, and an extensionless
                         path can fail to resolve. The build script sets
                         JAVA_HOME to this JDK, so java.home points here. -->
                    <executable>${java.home}/bin/javac.exe</executable>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
            </plugin>
            <!-- Bundles only the lsp4j artifacts into the plugin jar so
                 their classes are on the plugin's own classloader at
                 runtime; gson and the platform classes keep coming from
                 the IDE. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>org.eclipse.lsp4j:*</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>org.eclipse.lsp4j:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>*.DSA</exclude>
                                        <exclude>*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
