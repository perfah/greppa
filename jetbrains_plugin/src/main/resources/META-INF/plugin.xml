<idea-plugin>
    <id>com.perfah.greppa</id>
    <name>Greppa</name>
    <version>1.0.6</version>
    <vendor>Example</vendor>

    <description><![CDATA[
        An AI accelerated coding workflow that understands that some tasks are better done by you
    ]]></description>

    <idea-version since-build="232.0"/>

    <depends>com.intellij.modules.platform</depends>
    <!-- MarkdownParser renders the analysis with the IDE's bundled Markdown
         parser (org.intellij.markdown), which lives in the Markdown plugin's
         classloader. Without this dependency those classes are not visible
         to this plugin at runtime. -->
    <depends>org.intellij.plugins.markdown</depends>

    <extensions defaultExtensionNs="com.intellij">
        <platform.lsp.serverSupportProvider
                implementation="com.perfah.greppa.GreppaLspServerSupportProvider"/>
        <applicationConfigurable
                parentId="tools"
                instance="com.perfah.greppa.GreppaSettingsConfigurable"
                id="com.perfah.greppa.GreppaSettingsConfigurable"
                displayName="Greppa LSP Server"/>
        <applicationService
                serviceImplementation="com.perfah.greppa.GreppaSettingsState"/>
        <toolWindow id="Greppa"
                    anchor="right"
                    factoryClass="com.perfah.greppa.HintsToolWindowFactory"
                    icon="/icon.svg"
                    canCloseContents="false"/>
        <!-- Ranks the Greppa LSP completion item to the top of the
             completion popup; see GreppaCompletionWeigher. order="first"
             makes it the leading sorting criterion, ahead of any other
             custom weigher (e.g. one registered by the Rust plugin). -->
        <lookup.elementWeigher
                implementationClass="com.perfah.greppa.GreppaCompletionWeigher"
                order="first"/>
        <!-- Subscribes, once per project after startup, the save listener
             that refreshes the analysis when a document is saved (Ctrl+S,
             Save All, autosave) by writing the tick trigger file the
             reload button uses; see GreppaProjectActivity. -->
        <postStartupActivity implementation="com.perfah.greppa.GreppaProjectActivity"/>
    </extensions>

    <actions>
        <action id="com.perfah.greppa.OpenGreppaSettings"
                class="com.perfah.greppa.OpenGreppaSettingsAction"
                text="Greppa Settings"
                description="Open Greppa LSP Server settings">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
